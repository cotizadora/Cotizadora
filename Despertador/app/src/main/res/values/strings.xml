    <!-- Permisos -->
    <string name="perm_exact_title">Permiso de alarmas exactas</string>
    <string name="perm_exact_msg">Para que la alarma suene a la hora exacta, Android necesita que permitas «Alarmas y recordatorios» a Despertador. Se abrirá la pantalla de ajustes; activa el permiso y vuelve. La alarma queda desactivada hasta entonces.</string>
    <string name="perm_notif_title">Permiso de notificaciones</string>
    <string name="perm_notif_msg">Despertador muestra la pantalla de alarma y los botones Posponer/Detener mediante una notificación. Sin este permiso la alarma sonaría, pero podrías no ver la pantalla en el teléfono bloqueado.</string>
