{
  "manifest_version": 3,
  "name": "ShortCut-Vicidial-GO",
  "version": "1.2.5",
  "author": "Eduardo Pérez",
  "description": "Graba una vez y repite con un clic: cambia tu estado y tus pausas en Vicidial y avanza por GO y el multicotizador de Bci Seguros. Sin navegar menús. Basado en ShortCut-VocalCRM de Eduardo Pérez — soporte WhatsApp +56 9 2769 0949.",
  "action": {
    "default_title": "ShortCut-Vicidial-GO v1.2.5",
    "default_popup": "control.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "*://vicidial.recaall.simtastic.cl/*",
    "*://*.bciseguros.cl/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_about_blank": true
    },
    {
      "matches": [
        "*://vicidial.recaall.simtastic.cl/*",
        "*://*.bciseguros.cl/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "default-config.json",
        "control.html",
        "control.js",
        "icon48.png"
      ],
      "matches": [
        "*://vicidial.recaall.simtastic.cl/*",
        "*://*.bciseguros.cl/*"
      ]
    }
  ]
}